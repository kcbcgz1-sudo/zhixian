// 知闲 · Prisma 스키마 (docs/02 데이터모델 기반, MVP)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  reviewing // 审核中
  published // 已发布
  removed   // 已下架
}

enum InteractionType {
  like
  favorite
  comment
}

model User {
  id           String        @id @default(cuid())
  phone        String?       @unique
  wechatId     String?       @unique
  username     String?       @unique
  email        String?       @unique
  passwordHash String?
  nickname     String
  avatar       String?
  city         String        @default("广州")
  points       Int           @default(0)
  level        Int           @default(1)
  status       String        @default("active") // active/limited/banned
  role         String        @default("user")   // user/admin
  posts        Post[]
  interactions Interaction[]
  ledger       PointsLedger[]
  createdAt    DateTime      @default(now())
}

model Category {
  id              String   @id @default(cuid())
  code            String   @unique // 영문/숫자 식별자 (예: fishing) — Post.category 참조값
  name            String   // 中文 표시명 (예: 钓鱼)
  sort            Int      @default(0) // 출력순서 (오름차순)
  writeMinLevel   Int      @default(1) // 글쓰기 최소 회원레벨
  commentMinLevel Int      @default(1) // 댓글 최소 회원레벨
  active          Boolean  @default(true) // 노출 여부(삭제 대신 숨김)
  createdAt       DateTime @default(now())

  @@index([active, sort])
}

model Post {
  id           String        @id @default(cuid())
  author       User          @relation(fields: [authorId], references: [id])
  authorId     String
  category     String        // Category.code 참조
  title        String
  body         String
  district     String?
  locationPoi  String?
  attributes   Json          @default("{}") // 垂类 전용 필드 + 표시용(tags/authorTitle/aiImage 등)
  warnTips     String?
  isQuality    Boolean       @default(false)
  qualityScore Int           @default(0)
  trustScore   Float         @default(0)
  status       PostStatus    @default(published)
  images       PostImage[]
  interactions Interaction[]
  createdAt    DateTime      @default(now())
  publishedAt  DateTime?

  @@index([category, status])
}

model PostImage {
  id     String @id @default(cuid())
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  url    String
  sort   Int    @default(0)
}

model Interaction {
  id        String          @id @default(cuid())
  post      Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  user      User            @relation(fields: [userId], references: [id])
  userId    String
  type      InteractionType
  content   String? // 评论 내용
  createdAt DateTime        @default(now())

  @@index([postId, type])
}

model Report {
  id         String   @id @default(cuid())
  postId     String
  reporterId String
  reason     String
  status     String   @default("pending") // pending/valid/rejected
  createdAt  DateTime @default(now())
}

model PointsLedger {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id])
  userId       String
  change       Int
  reason       String
  refId        String?
  balanceAfter Int
  createdAt    DateTime @default(now())
}
